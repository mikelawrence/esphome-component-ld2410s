{
    "configurations": [
        {
            "name": "Win32",
            "includePath": [
                "${workspaceFolder}/../esphome-modified",
                "${workspaceFolder}/components",
                "${env:USERPROFILE}/.platformio/lib/ArduinoJson/src"
            ],
            "forcedInclude": [
                "${workspaceFolder}/../esphome-modified/esphome/core/defines.h"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}/../esphome-modified/**",
                    "${workspaceFolder}/components/**",
                    "${env:USERPROFILE}/.platformio/lib/ArduinoJson/src/**"
                ]
            },
            "intelliSenseMode": "windows-gcc-x86",
            "compilerPath": "${env:USERPROFILE}/.platformio/packages/toolchain-xtensa-esp32/bin/xtensa-esp32-elf-g++.exe",
            "cStandard": "c17",
            "cppStandard": "gnu++17"
        },
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/../esphome-modified",
                "${workspaceFolder}/components",
                "/workspaces/platformio/ArduinoJson"
            ],
            "forcedInclude": [
                "${workspaceFolder}/../esphome-modified/esphome/core/defines.h"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}/../esphome-modified/**",
                    "${workspaceFolder}/components/**",
                    "/workspaces/platformio/ArduinoJson/**"
                ]
            },
            "intelliSenseMode": "linux-gcc-x64",
            "compilerPath": "/usr/bin/g++",
            "cStandard": "c17",
            "cppStandard": "gnu++17"
        }
    ],
    "version": 4
}